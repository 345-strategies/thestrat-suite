paintOutsideBars = input.bool(true, "3 (Outside)", inline = "bc_f2", group = grpBarColor, active = barColorMode == "Strat Candles")
paintFailedBars = input.bool(true, "F2 (Failing)", inline = "bc_f2", group = grpBarColor, active = barColorMode == "Strat Candles")
colorFtfcUpBar = input.color(#4caf50, "Up / Down / Conflict", inline = "bc_ftfc", group = grpBarColor, active = barColorMode == "FTFC Candles", tooltip = "Candle colors for full timeframe continuity up, down, and conflict.")
