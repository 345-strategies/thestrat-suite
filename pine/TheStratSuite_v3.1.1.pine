//
// BARCOLOR-1 (2026-07-30): v3 bar coloring. Chart candles painted by Strat classification
// (the data table's CC classifier, reused) or by Full Timeframe Continuity (per-bar chart
// close vs served HTF opens, so painted history is honest - see SECTION 14 for the engine
// and the lookahead rationale). Inputs live in "Display - Bar Coloring".
//
// BARNUM-1 (2026-10-23): Bar Numbers. Each chart candle's Strat number (1, 2u, 2d, 3u, 3d,
// F2u, F2d) printed beside it, from the same classifier as Strat Candles and the table's CC
// cell. plotshape, not labels, so the level-label budget is untouched. Tiered emphasis fades
// plain 2s so 1s, 3s and Failing 2s stand out. Off by default; inputs in "Display - Bar
// Numbers", engine in SECTION 15.
//
// NOTATION-1 (2026-07-21): canonical uppercase F2u/F2d everywhere. The lowercase live-'f'
// (f2u/f2d for the forming candle) is retired: notation is tense-free; liveness is carried
// by slot position (last token = forming candle), the '*' potential prefix, and words
// (FAILING/Failed). Matches priceactionapi notation. Display-string change only, no logic.
//
// Multi-timeframe price action indicator implementing TheStrat methodology.
// Detects key patterns including inside bars, hammers, shooters, and Failed 2s
// (Range Reclaims) with intelligent signal consolidation and extensive customization.
//
// Features:
//   - 6 configurable timeframes with independent settings
//   - Bar coloring by Strat classification or timeframe continuity (v3)
//   - Bar numbers (1/2u/2d/3) on chart candles, with tiered emphasis
//   - Pattern detection: Inside bars, Hammers, Shooters, Failed 2s, Outside bars
//   - Magnitude and Exhaustion level targets
//   - Full Timeframe Continuity (FTFC) filtering
//   - Domino detection (consecutive inside bars across timeframes)
//   - Preview mode for planning ahead before market open
//   - Consolidated alerts with emoji indicators
//   - Data table showing current state across all timeframes
//
// For setup guides and documentation, visit: thestratsuite.com

indicator("TheStrat Suite - v3.1.1", shorttitle = "TheStrat Suite", overlay = true, max_labels_count = 200, max_lines_count = 200, max_boxes_count = 200, max_bars_back = 200)

// GRAMMAR-LIB-1 (2026-08-18): bar classification, hammers/shooters, and FTFC now come
// from the TheStratGrammar library - one classifier, spec-tested against the Python
// reference and this file's previous inline logic (60k-bar differential, 0 mismatches).
// Everything below that used to define classification is now a thin wrapper keeping the
// original signature, so no call site changed and no behavior changed.
import SpinTrades/TheStratGrammar/1 as sg

// FIX NO-HA-1 (2026-10-24): refuse Heikin Ashi charts. TheStrat reads traded OHLC; Heikin
// Ashi candles are averages, so every bar type, trigger and target would be wrong - and
// because the slots request syminfo.tickerid, the HTF slots inherit Heikin Ashi prices too.
// Halting here means nothing draws and no alert fires on a chart the Suite cannot read.
if chart.is_heikinashi
    runtime.error("Heikin Ashi charts are not supported: TheStrat needs real candles. Switch the chart to Candles or Bars.")

// ============================================================================
// SECTION 1: HELPER FUNCTIONS
// ============================================================================

getTablePos(pos) =>
    result = switch pos
        "Bottom Center" => position.bottom_center
        "Bottom Left"   => position.bottom_left
        "Bottom Right"  => position.bottom_right
        "Middle Center" => position.middle_center
        "Middle Left"   => position.middle_left
        "Middle Right"  => position.middle_right
        "Top Center"    => position.top_center
        "Top Left"      => position.top_left
        "Top Right"     => position.top_right
        => position.bottom_right
    result

getSize(sizeStr) =>
    result = switch sizeStr
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.small
    result

getTimeframeLabel(tf) =>
    result = switch tf
        "1" => "1m"
        "3" => "3m"
        "5" => "5m"
        "15" => "15m"
        "30" => "30m"
        "60" => "1H"
        "120" => "2H"
        "240" => "4H"
        "480" => "8H"
        "720" => "12H"
        "D" => "D"
        "1d" => "D"
        "W" => "W"
        "1W" => "W"
        "M" => "M"
        "1M" => "M"
        "3M" => "3M"
        "6M" => "6M"
        "12M" => "12M"
        => tf
    result

getLineStyle(style) =>
    style == "Solid" ? line.style_solid : style == "Dashed" ? line.style_dashed : line.style_dotted


// Update an existing line in-place or create a new one. Returns the line reference.
updateOrCreateLine(line ref, int x1, float y1, int x2, float y2, color c, int w, string style) =>
    if na(ref)
        line.new(x1, y1, x2, y2, color = c, width = w, style = style, xloc = xloc.bar_time)
    else
        line.set_xy1(ref, x1, y1)
        line.set_xy2(ref, x2, y2)
        line.set_color(ref, c)
        line.set_width(ref, w)
        line.set_style(ref, style)
        ref

// Update an existing box in-place or create a new one. Returns the box reference.
updateOrCreateBox(box ref, int x1, float y1, int x2, float y2, color bgc, color borderc) =>
    if na(ref)
        box.new(x1, y1, x2, y2, bgcolor = bgc, border_color = borderc, xloc = xloc.bar_time)
    else
        box.set_lefttop(ref, x1, y1)
        box.set_rightbottom(ref, x2, y2)
        box.set_bgcolor(ref, bgc)
        box.set_border_color(ref, borderc)
        ref

// Delete a line if it exists, return na
deleteLine(line ref) =>
    if not na(ref)
        line.delete(ref)
    line(na)

// Delete a box if it exists, return na
deleteBox(box ref) =>
    if not na(ref)
        box.delete(ref)
    box(na)

var chartTfSeconds = timeframe.in_seconds(timeframe.period)

// ============================================================================
// SECTION 2: INPUTS
// ============================================================================

// -------------------- PRESET --------------------
grpPreset = "Timeframe Preset"
tfPreset = input.string("TheStrat Classic", "Preset", options = ["Custom", "TheStrat Classic", "Scalp", "Day Trade", "Futures/Crypto", "Swing Trade", "Investing"], group = grpPreset, tooltip = "Select a timeframe preset to auto-configure timeframes and line widths. When set to anything other than Custom, individual Timeframe 1-6 settings are ignored. You must select Custom to use your own timeframe configuration.")
labelStyleMode = input.string("TheStrat", "Label Style", options = ["TheStrat", "Universal"], group = grpPreset, tooltip = "TheStrat: standard Strat combo notation (e.g. 2d-1-2u HAM). Universal: plain-language labels - REV (reversal), CONT (continuation), INS (inside), OUT (outside), EXP (expansion), plus FAILING when a breakout is failing - with an up/down arrow for direction and a diamond for hammer/shooter confidence. Designed for traders who are new to TheStrat or prefer a simplified view.")
simpleLabelMode = labelStyleMode == "Universal"
customTFs = tfPreset == "Custom"  // FIX MOD-3: true only when no preset is active; gates the Timeframe rows' `active`

// -------------------- TIMEFRAMES --------------------
// FIX MOD-3: every Timeframe row is greyed out (active = customTFs) while a preset is selected,
// since presets override these. Direct UX signal that the manual config is inert under a preset.
grpTFs = "Timeframes"
tf1Enabled = input.bool(false, "Timeframe 1", inline = "tf1a", group = grpTFs, active = customTFs)
tf1 = input.timeframe("15", "", inline = "tf1a", group = grpTFs, active = customTFs)
tf1LineWidth = input.int(1, "Width", minval = 1, maxval = 5, inline = "tf1b", group = grpTFs, active = customTFs)
tf1ShowOpen = input.bool(false, "Open", inline = "tf1b", group = grpTFs, active = customTFs)

tf2Enabled = input.bool(false, "Timeframe 2", inline = "tf2a", group = grpTFs, active = customTFs)
tf2 = input.timeframe("30", "", inline = "tf2a", group = grpTFs, active = customTFs)
tf2LineWidth = input.int(1, "Width", minval = 1, maxval = 5, inline = "tf2b", group = grpTFs, active = customTFs)
tf2ShowOpen = input.bool(false, "Open", inline = "tf2b", group = grpTFs, active = customTFs)

tf3Enabled = input.bool(false, "Timeframe 3", inline = "tf3a", group = grpTFs, active = customTFs)
tf3 = input.timeframe("60", "", inline = "tf3a", group = grpTFs, active = customTFs)
tf3LineWidth = input.int(1, "Width", minval = 1, maxval = 5, inline = "tf3b", group = grpTFs, active = customTFs)
tf3ShowOpen = input.bool(false, "Open", inline = "tf3b", group = grpTFs, active = customTFs)

tf4Enabled = input.bool(false, "Timeframe 4", inline = "tf4a", group = grpTFs, active = customTFs)
tf4 = input.timeframe("D", "", inline = "tf4a", group = grpTFs, active = customTFs)
tf4LineWidth = input.int(2, "Width", minval = 1, maxval = 5, inline = "tf4b", group = grpTFs, active = customTFs)
tf4ShowOpen = input.bool(false, "Open", inline = "tf4b", group = grpTFs, active = customTFs)

tf5Enabled = input.bool(false, "Timeframe 5", inline = "tf5a", group = grpTFs, active = customTFs)
tf5 = input.timeframe("W", "", inline = "tf5a", group = grpTFs, active = customTFs)
tf5LineWidth = input.int(3, "Width", minval = 1, maxval = 5, inline = "tf5b", group = grpTFs, active = customTFs)
tf5ShowOpen = input.bool(false, "Open", inline = "tf5b", group = grpTFs, active = customTFs)

tf6Enabled = input.bool(false, "Timeframe 6", inline = "tf6a", group = grpTFs, active = customTFs)
tf6 = input.timeframe("M", "", inline = "tf6a", group = grpTFs, active = customTFs)
tf6LineWidth = input.int(4, "Width", minval = 1, maxval = 5, inline = "tf6b", group = grpTFs, active = customTFs)
tf6ShowOpen = input.bool(false, "Open", inline = "tf6b", group = grpTFs, active = customTFs)

// Resolve preset overrides
// When preset != Custom, these override the individual TF inputs
usePreset = tfPreset != "Custom"

rTF1 = usePreset ? (tfPreset == "TheStrat Classic" ? "30"  : tfPreset == "Scalp" ? "5"   : tfPreset == "Day Trade" ? "15"  : tfPreset == "Futures/Crypto" ? "60"  : tfPreset == "Swing Trade" ? "240" : tfPreset == "Investing" ? "W"   : tf1) : tf1
rTF2 = usePreset ? (tfPreset == "TheStrat Classic" ? "60"  : tfPreset == "Scalp" ? "15"  : tfPreset == "Day Trade" ? "30"  : tfPreset == "Futures/Crypto" ? "240" : tfPreset == "Swing Trade" ? "D"   : tfPreset == "Investing" ? "M"   : tf2) : tf2
rTF3 = usePreset ? (tfPreset == "TheStrat Classic" ? "D"   : tfPreset == "Scalp" ? "30"  : tfPreset == "Day Trade" ? "60"  : tfPreset == "Futures/Crypto" ? "720" : tfPreset == "Swing Trade" ? "W"   : tfPreset == "Investing" ? "3M"  : tf3) : tf3
rTF4 = usePreset ? (tfPreset == "TheStrat Classic" ? "W"   : tfPreset == "Scalp" ? "60"  : tfPreset == "Day Trade" ? "240" : tfPreset == "Futures/Crypto" ? "D"   : tfPreset == "Swing Trade" ? "M"   : tfPreset == "Investing" ? "12M" : tf4) : tf4
rTF5 = usePreset ? (tfPreset == "TheStrat Classic" ? "M"   : tfPreset == "Scalp" ? "60"  : tfPreset == "Day Trade" ? "D"   : tfPreset == "Futures/Crypto" ? "W"   : tfPreset == "Swing Trade" ? "M"   : tfPreset == "Investing" ? "12M" : tf5) : tf5
rTF6 = usePreset ? (tfPreset == "TheStrat Classic" ? "M"   : tfPreset == "Scalp" ? "60"  : tfPreset == "Day Trade" ? "D"   : tfPreset == "Futures/Crypto" ? "W"   : tfPreset == "Swing Trade" ? "M"   : tfPreset == "Investing" ? "12M" : tf6) : tf6

rEN1 = usePreset ? true  : tf1Enabled
rEN2 = usePreset ? true  : tf2Enabled
rEN3 = usePreset ? true  : tf3Enabled
rEN4 = usePreset ? true  : tf4Enabled
rEN5 = usePreset ? (tfPreset == "TheStrat Classic" or tfPreset == "Futures/Crypto" or tfPreset == "Day Trade") : tf5Enabled
rEN6 = usePreset ? false : tf6Enabled

rLW1 = usePreset ? 1 : tf1LineWidth
rLW2 = usePreset ? (tfPreset == "TheStrat Classic" or tfPreset == "Day Trade" ? 1 : 2) : tf2LineWidth
rLW3 = usePreset ? (tfPreset == "TheStrat Classic" ? 2 : tfPreset == "Futures/Crypto" ? 2 : tfPreset == "Day Trade" ? 2 : 3) : tf3LineWidth
rLW4 = usePreset ? (tfPreset == "TheStrat Classic" ? 3 : tfPreset == "Futures/Crypto" ? 3 : tfPreset == "Day Trade" ? 3 : 4) : tf4LineWidth
rLW5 = usePreset ? 4 : tf5LineWidth
rLW6 = usePreset ? 4 : tf6LineWidth

rSO1 = usePreset ? false : tf1ShowOpen
rSO2 = usePreset ? false : tf2ShowOpen
rSO3 = usePreset ? false : tf3ShowOpen
rSO4 = usePreset ? false : tf4ShowOpen
rSO5 = usePreset ? false : tf5ShowOpen
rSO6 = usePreset ? false : tf6ShowOpen

// -------------------- SIGNALS --------------------
grpSigRev = "Signals - Reversals"
showInsideReversals = input.bool(true, "Inside Reversals |", inline = "s_ir", group = grpSigRev, tooltip = "C1 is inside, CC breaks opposite C2's direction (e.g. 2d-1-2u). The bread-and-butter Strat pattern: price consolidated then reversed.")
insideRevOnlyMomo = input.bool(false, "HAM/SHO", inline = "s_ir", group = grpSigRev, tooltip = "HAM/SHO filter: Require C1 to be a hammer or shooter. These candles tested one side and got rejected, adding conviction that the breakout direction has structural backing.")
insideRevRequireFTFC = input.bool(false, "FTFC", inline = "s_ir", group = grpSigRev, tooltip = "FTFC filter: Require all monitored timeframes to agree on direction. Removes setups that fight the broader structural alignment, keeping only those swimming with the current.")

showAllReversals = input.bool(true, "2-2 Reversals |", inline = "s_2r", group = grpSigRev, tooltip = "Direct reversal with no inside bar pause (e.g. 2d-2u). CC immediately breaks opposite C1. Faster signal but less coiled energy than inside reversals.")
reversalsRequireActionable = input.bool(false, "HAM/SHO", inline = "s_2r", group = grpSigRev, tooltip = "HAM/SHO filter: Require C1 to be a hammer or shooter. These candles tested one side and got rejected, adding conviction that the breakout direction has structural backing.")
reversalsRequireC1F2 = input.bool(false, "F2", inline = "s_2r", group = grpSigRev, tooltip = "F2 filter: Require C1 to be a Failed 2 itself (e.g. F2d-2u). Adds structural confluence: the prior bar already reversed a failed breakout, so trapped traders from that failure fuel the current move.")
reversalsRequireFTFC = input.bool(false, "FTFC", inline = "s_2r", group = grpSigRev, tooltip = "FTFC filter: Require all monitored timeframes to agree on direction. Removes setups that fight the broader structural alignment, keeping only those swimming with the current.")

grpSigCont = "Signals - Continuations"
showInsideContinuations = input.bool(true, "Inside Continuations |", inline = "s_ic", group = grpSigCont, tooltip = "C1 is inside, CC breaks same direction as C2 (e.g. 2u-1-2u). Price paused to consolidate then continued the prior move. Trend continuation with a pullback.")
insideContOnlyMomo = input.bool(false, "HAM/SHO", inline = "s_ic", group = grpSigCont, tooltip = "HAM/SHO filter: Require C1 to be a hammer or shooter. These candles tested one side and got rejected, adding conviction that the breakout direction has structural backing.")
insideContRequireFTFC = input.bool(false, "FTFC", inline = "s_ic", group = grpSigCont, tooltip = "FTFC filter: Require all monitored timeframes to agree on direction. Removes setups that fight the broader structural alignment, keeping only those swimming with the current.")

showContinuations = input.bool(false, "2-2 Continuations |", inline = "s_2c", group = grpSigCont, tooltip = "Sustained momentum with no pause (e.g. 2u-2u). CC keeps pushing in C1's direction. Can be noisy without filters since any two trending bars qualify.")
twoTwoContOnlyMomo = input.bool(false, "HAM/SHO", inline = "s_2c", group = grpSigCont, tooltip = "HAM/SHO filter: Require C1 to be a hammer or shooter. These candles tested one side and got rejected, adding conviction that the breakout direction has structural backing.")
continuationsRequireFTFC = input.bool(false, "FTFC", inline = "s_2c", group = grpSigCont, tooltip = "FTFC filter: Require all monitored timeframes to agree on direction. Removes setups that fight the broader structural alignment, keeping only those swimming with the current.")

grpSigF2 = "Signals - Reclaims"
show_p3_toggle = input.bool(false, "Failing 2s (Range Reclaims) |", inline = "s_f2", group = grpSigF2, tooltip = "Show Range Reclaim signals where price reverses after breaking out. Also known as Failing 2s, Potential 3, or 1-bar Rev Strat.")
p3RequireFTFC = input.bool(false, "FTFC", inline = "s_f2", group = grpSigF2, tooltip = "FTFC filter: Require all monitored timeframes to agree on direction. Removes setups that fight the broader structural alignment, keeping only those swimming with the current.")

grpSigExp = "Signals - Expansions"
showRangeExpansions = input.bool(false, "3-2 Expansions |", inline = "s_3e", group = grpSigExp, tooltip = "C1 was a 3-bar (outside bar), CC commits to one direction (e.g. 3u-2u). After C1 took both sides, CC resolves the indecision. Often powerful when the 3-bar shook out weak hands.")
rangeExpOnlyMomo = input.bool(false, "HAM/SHO", inline = "s_3e", group = grpSigExp, tooltip = "HAM/SHO filter: Require C1 to be a hammer or shooter. A 3-bar that also formed a hammer/shooter tested and rejected one side despite the range expansion, adding directional conviction.")
rangeExpansionsRequireFTFC = input.bool(false, "FTFC", inline = "s_3e", group = grpSigExp, tooltip = "FTFC filter: Require all monitored timeframes to agree on direction. Removes setups that fight the broader structural alignment, keeping only those swimming with the current.")

show3Expansions = input.bool(false, "Outside Bars (3 Exp) |", inline = "s_ob", group = grpSigExp, tooltip = "CC itself is a 3-bar, engulfing C1's entire range. Represents range expansion and volatility. Direction determined by close vs open (3u = bullish, 3d = bearish).")
threeExpRequireFTFC = input.bool(false, "FTFC", inline = "s_ob", group = grpSigExp, tooltip = "FTFC filter: Require all monitored timeframes to agree on direction. Removes setups that fight the broader structural alignment, keeping only those swimming with the current.")

// -------------------- FILTERS --------------------
grpHammerShooter = "Filters - Hammer/Shooter Detection"
logicType = input.string("Broad (Loose)", "Definition", options = ["Broad (Loose)", "Classic", "Pin Bar (Strict)"], group = grpHammerShooter, tooltip = "Broad: relaxed detection based on body position. Classic: small body, long wick (3x body), body in upper/lower third. Pin Bar: stricter wick requirements.")
onlyColor = input.bool(false, "Match Candle Color", group = grpHammerShooter, tooltip = "When enabled, hammers must be green (bullish) and shooters must be red (bearish) to qualify")

grpDomino = "Filters - Domino Setups"
minDominoTFs = input.int(2, "Minimum Timeframes", minval = 2, maxval = 6, group = grpDomino, tooltip = "Minimum number of consecutive inside bar timeframes (with visible signals) to trigger a Domino. Respects your signal filter settings.")
showDominoInTable = input.bool(true, "Show in Data Table", group = grpDomino, tooltip = "Show a Domino row in the Data Table when consecutive inside bars are detected")

grpDirFilter = "Filters - Lead Signal"
enableDirectionalFilter = input.bool(false, "Only Show Signals Following the Lead", group = grpDirFilter, tooltip = "When enabled, only shows signals on lower timeframes that align with the direction of the highest timeframe signal in-force (the Lead). If no higher TF has a signal in-force, all signals are shown.")
// -------------------- MAGNITUDE & EXHAUSTION --------------------
grpMagExh = "Targets - Magnitude & Exhaustion"
showMagnitude = input.bool(true, "Show Magnitude Levels", group = grpMagExh, tooltip = "Show magnitude (C2 high/low) as take-profit targets for actionable signals")
magOnlyWhenInForce = input.bool(false, "  └ Only When In-Force", group = grpMagExh, tooltip = "Only show magnitude levels when the signal has triggered (breakout occurred). Hides targets on potential setups so you only see them when the trade is live.")
showExhaustion = input.bool(true, "Show Exhaustion Levels", group = grpMagExh, tooltip = "Show exhaustion levels (prior swing high/low beyond C2) as extended targets")
exhOnlyWhenInForce = input.bool(false, "  └ Only When In-Force", group = grpMagExh, tooltip = "Only show exhaustion levels when the signal has triggered (breakout occurred). Hides extended targets on potential setups so you only see them when the trade is live.")
exhRequiresMagHit = input.bool(false, "  └ Only After Magnitude Hit", group = grpMagExh, tooltip = "When enabled, exhaustion levels only appear after price has reached the magnitude level")

// Gate for exhaustion search: only scan for pivot-based exhaustion when targets are enabled
showAnyTargets = showMagnitude or showExhaustion

// -------------------- TAKE ACTION WINDOWS --------------------
grpTAW = "Targets - Take Action Windows"
showTakeActionWindows = input.bool(true, "Show Take Action Windows", group = grpTAW, tooltip = "Highlight the zone between trigger and target levels for actionable signals")
tawOnlyWhenInForce = input.bool(true, "  └ Only When In-Force", group = grpTAW, tooltip = "Only show take action windows when the signal has triggered (breakout occurred)")
tawExtendToExhaustion = input.bool(true, "Extend to Exhaustion", group = grpTAW, tooltip = "Extend the take action window to the exhaustion level instead of magnitude")
tawExhOnlyWhenInForce = input.bool(true, "  └ Only When In-Force", group = grpTAW, tooltip = "Only extend to exhaustion when the signal has triggered")
tawFillOpacity = input.int(8, "Fill Opacity", minval = 0, maxval = 100, group = grpTAW, tooltip = "Opacity of the take action window fill (0 = transparent, 100 = solid)")
tawBorderOpacity = input.int(30, "Border Opacity", minval = 0, maxval = 100, group = grpTAW, tooltip = "Opacity of the take action window border")
// -------------------- STOP LEVELS --------------------
grpStops = "Stops - Stop Levels"
showStopLevels = input.bool(false, "Enable", group = grpStops, tooltip = "Show stop loss levels on the opposite side of the trigger. Once a signal goes in force, the stop is locked and persists for the remainder of that period even if the signal is no longer in force.")
stopReference = input.string("CC", "Reference", options = ["CC", "C1"], group = grpStops, tooltip = "CC: stop tracks the breakout bar's opposite extreme in real time (updates as the candle forms, locks when it closes). Tighter risk, invalidated when the breakout candle itself is reversed. C1: stop at the prior bar's opposite side, locked when signal goes in force. Wider risk, invalidated when the full setup range is taken out. Failing 2 signals always use CC regardless of this setting.")
stopSmallestOnly = input.bool(false, "Smallest Timeframe Only", group = grpStops, tooltip = "Draw only the stop belonging to the smallest enabled timeframe that currently has one; stops on larger timeframes are hidden. Larger-timeframe stops keep tracking underneath (break even still arms, alert messages still carry their prices) - this only reduces what is drawn. Uses slot order, like the Lead Signal filter.", active = showStopLevels)  // FEATURE STOP-SMALLEST-1
stopBEatMag = input.bool(false, "Break Even at Magnitude", group = grpStops, tooltip = "Move stop to the entry trigger (break even) when price hits the magnitude level. If no magnitude level exists, uses exhaustion as the trigger instead.")
stopBEatExh = input.bool(false, "Break Even at Exhaustion", group = grpStops, tooltip = "Move stop to the entry trigger (break even) when price hits the exhaustion level. If no exhaustion level exists, uses magnitude as the trigger instead.")
stopColorMode = input.string("Opposite Signal", "Color Mode", options = ["Opposite Signal", "Match Signal", "Custom"], group = grpStops, tooltip = "Opposite Signal: bullish stops use the bearish signal color, bearish stops use the bullish signal color. Match Signal: stops match their signal's color. Custom: use the single color below for all stops.")
colorStop = input.color(#FFFFFF, "Custom Color", group = grpStops, tooltip = "Color for stop level lines and labels when Color Mode is set to Custom", active = showStopLevels and stopColorMode == "Custom")  // FIX MOD-3: only relevant when stops on AND Custom color mode
// -------------------- DISPLAY - PREVIEW MODE --------------------
grpPreview = "Display - Preview Mode"
// FIX AUTO-SESSION-1 (tooltip): states the scheduled-close rule first; the ET windows are the US closed-market schedule, not the whole rule.
previewMode = input.string("Auto", "Preview Mode", options = ["Off", "On", "Auto"], group = grpPreview, tooltip = "Off: never preview. Must be set to Off for Bar Replay mode. On: always preview next period levels. Auto: previews once the chart's current bar has passed its scheduled close and the market is not trading. It never activates while the current bar is still open: a weekly chart cannot preview until the week closes, an extended-hours chart waits for its 8 PM ET close. Closed-market windows: Stocks/ETFs/Options before 9:30 AM, after 4 PM ET and weekends. Futures/Forex/Commodities: weekends and the 5-6 PM ET maintenance window. Any symbol: 4 hours after its last bar's scheduled close (exchange holidays, early closes, non-US sessions, crypto outages). Automatically disabled during bar replay. Not available on Renko, Kagi, Line Break, Point & Figure or Range charts.")

// -------------------- DISPLAY - DATA TABLE --------------------
grpTable = "Display - Data Table"
showBarTypeTable = input.bool(true, "Show Data Table", group = grpTable, tooltip = "Show the multi-timeframe data table")
tableMode = input.string("Full", "Mode", options = ["Full", "Compact"], group = grpTable, tooltip = "Full: complete table with C2, C1, AS, CC columns. Compact: a single horizontal row of timeframe labels, color-coded. Use Compact Cell Color below to choose what that coloring means.")
